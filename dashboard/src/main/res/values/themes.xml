<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, borderless window so nothing flashes before Compose draws (#111111 = HA primary-background-color, dark) -->
    <style name="Theme.Dashboard" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/dashboard_background</item>
        <item name="android:colorBackground">@color/dashboard_background</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <color name="dashboard_background">#111111</color>
</resources>
